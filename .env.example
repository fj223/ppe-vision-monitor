# Local YOLOv8 PPE monitor
DATABASE_URL=postgresql+asyncpg://ppe_user:ppe_pass@postgres:5432/ppe_monitoring

# Place the fine-tuned checkpoint at backend/models/best.pt.
MODEL_PATH=models/best.pt
MODEL_CONFIDENCE=0.50
# MODEL_DEVICE=cpu

# Local evidence-frame storage, served at /snapshots.
SNAPSHOT_DIR=snapshots

# Optional RTSP streams: camera_id=rtsp_url pairs.
RTSP_STREAMS=
FRAME_INTERVAL_SECONDS=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
