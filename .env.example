# ============================================================
# PPE Compliance Monitoring System — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Database -----------------------------------------------
DATABASE_URL=postgresql+asyncpg://ppe_user:ppe_pass@postgres:5432/ppe_monitoring

# ---- Yandex Object Storage (S3-compatible) ------------------
YOS_ENDPOINT_URL=https://storage.yandexcloud.net
YOS_ACCESS_KEY_ID=<your-access-key-id>
YOS_SECRET_ACCESS_KEY=<your-secret-access-key>
YOS_BUCKET_NAME=ppe-violations

# ---- Yandex Vision API --------------------------------------
YANDEX_VISION_API_KEY=<your-vision-api-key>
YANDEX_VISION_FOLDER_ID=<your-folder-id>

# ---- RTSP Streams (comma-separated camera_id=rtsp_url pairs)
RTSP_STREAMS=cam_01=rtsp://192.168.1.10/stream,cam_02=rtsp://192.168.1.11/stream

# ---- Tuning (optional — defaults shown) ---------------------
FRAME_INTERVAL_SECONDS=2
VISION_API_TIMEOUT_SECONDS=5
MAX_RETRY_ATTEMPTS=5

# ---- Observability ------------------------------------------
LOG_LEVEL=INFO

# ---- CORS (comma-separated origins) -------------------------
CORS_ORIGINS=http://localhost:3000
